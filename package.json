{
  "name": "crawler-work-trial",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx services/crawler/src/scheduler/index.ts",
    "check": "tsc --noEmit",
    "start": "tsx services/crawler/src/loop/cli.ts start",
    "stop": "tsx services/crawler/src/loop/cli.ts stop",
    "status": "tsx services/crawler/src/loop/cli.ts status",
    "test": "tsx --test apps/dashboard/src/api/*.test.ts apps/dashboard/src/metrics/*.test.ts packages/core/src/*.test.ts services/crawler/src/scheduler/*.test.ts services/crawler/src/fetcher/*.test.ts services/crawler/src/fetcher/transports/*.test.ts tools/simulator/*.test.ts",
    "dashboard:api": "tsx apps/dashboard/src/api/index.ts",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "check:boundaries": "node tools/simulator/check-boundaries.mjs",
    "simulator": "node tools/simulator/server.mjs",
    "scheduler": "tsx services/crawler/src/scheduler/index.ts",
    "worker": "tsx services/crawler/src/fetcher/index.ts",
    "check:shadow": "node --import tsx tools/simulator/shadow.mjs",
    "check:durable": "node --import tsx tools/simulator/check-durable.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.0",
    "jsdom": "^31.0.0",
    "robots-parser": "^3.0.1"
  }
}
