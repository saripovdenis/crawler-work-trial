{
  "name": "crawler-work-trial",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx services/crawler/src/scheduler/index.ts",
    "check": "tsc --noEmit",
    "dashboard:api": "tsx apps/dashboard/src/api/index.ts",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "check:boundaries": "node tools/simulator/check-boundaries.mjs",
    "scheduler": "tsx services/crawler/src/scheduler/index.ts",
    "worker": "tsx services/crawler/src/fetcher/index.ts",
    "monitor": "node --env-file-if-exists=.env.monitor --import tsx services/monitor/src/index.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.0",
    "jsdom": "^31.0.0",
    "pg": "8.23.1",
    "robots-parser": "^3.0.1"
  }
}
