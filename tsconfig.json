{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "config/**/*.ts",
    "services/**/*.ts",
    "apps/dashboard/src/api/**/*.ts",
    "apps/dashboard/src/metrics/**/*.ts"
  ]
}
