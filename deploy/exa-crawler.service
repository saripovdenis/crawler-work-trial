[Unit]
Description=Exa news crawler v1.0.1
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/exa-crawler
ConditionPathExists=/var/lib/exa-crawler/ready
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=exa-crawler
Group=exa-crawler
WorkingDirectory=/opt/exa-crawler/v1.0.1
Environment=NODE_ENV=production
Environment=CRAWLER_DATA_DIR=/var/lib/exa-crawler/data
Environment=CRAWLER_PYTHON=/opt/exa-crawler/v1.0.1/.venv/bin/python
ExecStart=/usr/local/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=1500M
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/exa-crawler
CapabilityBoundingSet=
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
