[Unit]
After=postgresql.service
Wants=postgresql.service
Description=Exa durable scheduler and pipeline
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/exa-crawler
ConditionPathExists=/var/lib/exa-crawler/ready
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=crawler
Type=simple
User=exa-crawler
Group=exa-crawler
WorkingDirectory=/opt/exa-crawler/layout-v1
Environment=NODE_ENV=production
Environment=CRAWLER_DATA_DIR=/var/lib/exa-crawler/data
Environment=SCHEDULER_PORT=4319
ExecStart=/usr/local/bin/node --import tsx services/crawler/src/scheduler/index.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=2G
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
IPAddressDeny=any
IPAddressAllow=localhost
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/exa-crawler
CapabilityBoundingSet=
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
