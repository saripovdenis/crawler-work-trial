[Unit]
Description=Compare mirrored response hashes with local archives
After=exa-archive.service
ConditionPathExists=/etc/exa-archive-reader.env

[Service]
Type=oneshot
User=exa-crawler
Group=exa-crawler
EnvironmentFile=/etc/exa-archive-reader.env
Environment=CRAWLER_DATA_DIR=/var/lib/exa-crawler/data
Environment=ARCHIVE_VERIFY_LIMIT=1000
ExecStart=/usr/local/sbin/verify-exa-archive
TimeoutStartSec=120
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/exa-crawler/data/receipts
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
UMask=0077
