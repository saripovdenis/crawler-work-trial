[Unit]
After=postgresql.service
Wants=postgresql.service
Description=External news coverage reconciler
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/exa-crawler

[Service]
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=crawler
Type=simple
User=exa-crawler
Group=exa-crawler
WorkingDirectory=/opt/exa-crawler/reconcile-v1
Environment=NODE_ENV=production
Environment=RECONCILER_DB=/var/lib/exa-crawler/reconciliation/reconciler.sqlite
EnvironmentFile=/etc/exa-reconciler.env
ExecStart=/usr/local/bin/node --import tsx services/monitor/src/index.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=35
MemoryMax=512M
CPUQuota=40%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/exa-crawler/reconciliation
CapabilityBoundingSet=
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
